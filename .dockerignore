vitest.config.*
jest.config.*
cypress.config.*
playwright.config.*
*.test.*
*.spec.*

# Git
.git/
.gitignore
.gitattributes

# IDE and editor files
.vscode/
.idea/
*.swp
*.swo
*~

# Environment files (avoid leaking secrets into the build context)
.env
.env*.local
.env.development
.env.test
.env.production.local

