Dockerfile*
.dockerignore
compose.yaml
compose.yml
compose*.yaml
docker-compose*.yaml
docker-compose*.yml

# Documentation
*.md
docs/

# CI/CD configuration files
.github/
.gitlab-ci.yml
.travis.yml
.circleci/
Jenkinsfile

