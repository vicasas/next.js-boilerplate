{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "Renovate configuration",
  "extends": ["config:recommended"],
  "semanticCommits": "enabled",
  "commitMessageAction": "Bump",
  "commitMessageTopic": "{{depName}}",
  "commitMessageExtra": "from {{currentValue}} to {{newValue}}",
  "commitMessageLowerCase": "never",
  "labels": ["dependencies"],
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["before 6am on the first day of the month"]
  },
  "prConcurrentLimit": 30,
  "prHourlyLimit": 0,
  "rangeStrategy": "bump",
  "timezone": "UTC",
  "schedule": ["before 6am on Sunday"],
  "vulnerabilityAlerts": {
    "addLabels": ["security"]
  },
  "packageRules": [
    {
      "description": "Use 'chore' for all Renovate semantic commits",
      "matchFileNames": ["**/*"],
      "semanticCommitType": "chore"
    },
    {
      "description": "Restrict Node.js version updates in .nvmrc",
      "groupName": "node",
      "matchManagers": ["nvm"],
      "matchFileNames": [".nvmrc"],
      "allowedVersions": "^20 || ^22 || ^24"
    },
    {
      "description": "Restrict @types/node version updates",
      "groupName": "node",
      "matchPackageNames": ["@types/node"],
      "allowedVersions": "^20 || ^22 || ^24"
    },
    {
      "description": "Disable Node.js engine updates",
      "matchPackageNames": ["node"],
      "matchDepTypes": ["engines"],
      "enabled": false
    }
  ]
}
